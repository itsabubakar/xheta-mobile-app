{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.xheta.com/api"
      }
    },
    "preview": {
      "android": {
        "distribution": "internal",
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_API_URL": "https://api.xheta.com/api"
        }
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "distribution": "store",
        "env": {
          "EXPO_PUBLIC_API_URL": "https://api.xheta.com/api"
        }
      },
      "channel": "production"
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
